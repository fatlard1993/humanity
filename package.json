{
	"name": "humanity",
	"version": "3.0.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "A card game for terrible people",
	"author": "fatlard1993",
	"license": "MIT",
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run build",
		"build": "bun run build:clean && bun run client/build.js",
		"build:clean": "rm -rf ./client/build/",
		"build:watch": "bun run build -- --watch",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"version": "npm version"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/humanity.git"
	},
	"bugs": {
		"url": "https://github.com/fatlard1993/humanity/issues"
	},
	"homepage": "https://github.com/fatlard1993/humanity#readme",
	"dependencies": {
		"@fatlard1993/web-game-framework": "github:fatlard1993/web-game-framework#b61cd94",
		"argi-cli": "^1.0.0",
		"lowdb": "^7.0.1",
		"qrcode": "^1.5.4",
		"@vanilla-bean/components": "^2.0.1",
		"@vanilla-bean/hypertether": "^1.0.1",
		"augmented-ui": "^2.0.0",
		"source-code-pro": "^2.42.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.10.6",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-unicorn": "^72.0.0",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"prettier": "3.9.5"
	}
}
